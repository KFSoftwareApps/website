# Handle extensionless URLs for Next.js static export
RewriteEngine On
DirectoryIndex index.html

# Redirect old "puntajx" URL to correct "puantajx"
RewriteRule ^apps/puntajx/?$ /apps/puantajx/ [R=301,L]

# Serve HTML files without the .html extension
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^ %{REQUEST_URI}.html [L]

# Ensure directory requests have a trailing slash
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]
